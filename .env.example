# Copy to .env -- docker compose loads it automatically.
# Everything else has a working default in docker-compose.yml.

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Free key, no credit card: https://aistudio.google.com/apikey
# Leave empty to run without AI -- semantic search and generation return 503,
# the rest of the app works normally.
GEMINI_API_KEY=

# Host ports. Change these only if something else already uses 3000/3001.
# NEXT_PUBLIC_API_URL and CORS_ORIGIN must be updated to match.
FRONTEND_PORT=3000
BACKEND_PORT=3001
DB_PORT=5432
REDIS_PORT=6379
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
