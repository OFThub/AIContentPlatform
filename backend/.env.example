# ---- Server ----
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ---- PostgreSQL (pgvector) ----
# docker compose provides this host automatically; override for local runs.
DATABASE_URL=postgresql://postgres:postgres@db:5432/aicontent

# ---- Redis ----
REDIS_URL=redis://cache:6379

# ---- Auth ----
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI (Google Gemini, free tier -- https://aistudio.google.com/apikey) ----
# Gemini exposes an OpenAI-compatible endpoint, so the `openai` SDK is used as-is.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Must stay <= 2000: pgvector's HNSW index does not support more dimensions.
GEMINI_EMBEDDING_DIMENSIONS=768

# ---- Cache TTL (seconds) ----
CACHE_TTL_SHORT=60
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=3600
